PORT=5000
NODE_ENV=development
# Local MongoDB (default). For MongoDB Atlas, paste your connection string here instead and keep the database name hotelpro_system
MONGO_URI=mongodb://127.0.0.1:27017/hotelpro_system
# DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=7d
CLIENT_URL=http://localhost:5173
# Email (optional - without it, emails are only logged to the console)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=HotelPro <no-reply@hotelpro.com>
# Payments. "mock" approves every payment (local testing). Use "razorpay" for real checkout.
PAYMENT_MODE=mock
# Razorpay: Dashboard > Settings > API Keys (start with Test Mode keys that begin rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional, only works once the site is online: Dashboard > Webhooks, URL = https://YOUR-SITE/api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=
